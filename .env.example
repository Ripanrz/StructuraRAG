# Optional local model (Ollama exposes an OpenAI-compatible /v1 endpoint)
STRUCTURARAG_LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
STRUCTURARAG_LOCAL_AI_MODEL=qwen2.5:7b-instruct
# Optional if your model endpoint requires a bearer token
STRUCTURARAG_LOCAL_AI_API_KEY=

# Optional OCR (requires local Tesseract + Indonesian/English language data)
STRUCTURARAG_ENABLE_OCR=0

# Optional local app protection (set a unique password before exposing any hosted URL)
STRUCTURARAG_ACCESS_USERNAME=structurarag
STRUCTURARAG_ACCESS_PASSWORD=

# Vercel deployment defaults (the app enforces a 4 MiB maximum upload)
STRUCTURARAG_VERCEL_MAX_UPLOAD_BYTES=4194304
STRUCTURARAG_VERCEL_CONVERT_TIMEOUT=240
STRUCTURARAG_PAGES_PER_CALL=1
STRUCTURARAG_ALLOWED_HOSTS=
